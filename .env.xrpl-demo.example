# ─── XRPL EVM testnet ──────────────────────────────────────────────────────────
XRPL_EVM_RPC_URL=https://rpc.testnet.xrplevm.org
XRPL_EVM_CHAIN_ID=1449000

# EVM private key with testnet XRP for gas
DEPLOYER_PRIVATE_KEY=0xYourEvmPrivateKey

# Owner for the deployed receiver (defaults to deployer if omitted)
# DEPLOY_OWNER=0xYourMultisigOrEoa

# ─── Axelar contracts on XRPL EVM testnet ──────────────────────────────────────
AXELAR_GATEWAY=0xe432150cce91c13a887f7D836923d5597adD8E31
INTERCHAIN_TOKEN_SERVICE=0xB5FB4BE02232B1bBA4dC8f81dc24C26980dE9e3C

# ─── After running deployXrplEvmDemoReceiver ────────────────────────────────────
XRPL_EVM_DEMO_RECEIVER=0xYourDeployedDemoReceiverAddress

# ─── XRPL Ledger testnet ───────────────────────────────────────────────────────
XRPL_RPC_URL=wss://s.altnet.rippletest.net:51233

# Funded XRPL testnet wallet seed (get one at https://xrpl.org/xrp-testnet-faucet.html)
XRPL_SEED=sYourFundedXrplTestnetSeed

# Axelar gateway account on XRPL Ledger testnet
XRPL_AXELAR_GATEWAY=rNrjh1KGZk2jBR3wPfAQnoidtFFYQKbQn2

# Axelar chain name for XRPL EVM (as registered in Axelar)
XRPL_EVM_AXELAR_CHAIN=xrpl-evm

# ─── Trusted source configuration ──────────────────────────────────────────────
# GMP trusted source: the Axelar source-chain name and address that the receiver
# will accept execute() calls from. The gateway validates this before calling execute.
# For testnet, the Axelar relayer forwards XRPL Ledger payments; set these to the
# source identifiers Axelar uses for XRPL Ledger GMP.
XRPL_GMP_SOURCE_CHAIN=xrpl
# XRPL_GMP_SOURCE_ADDRESS=      # optional — leave blank to configure manually after deploy

# ITS trusted source (UTF-8 address bytes from the XRPL Ledger side)
XRPL_ITS_SOURCE_CHAIN=xrpl
# XRPL_ITS_SOURCE_ADDRESS=      # optional — UTF-8 or 0x-hex bytes

# ─── GMP demo (sendXrplGmpMessage.ts) ──────────────────────────────────────────
# XRP drops to send as gas for the GMP call (no token transfer, just gas)
XRPL_GMP_GAS_DROPS=3000000

# Text message to embed in the payload
XRPL_GMP_MESSAGE=hello from xrpl ledger

# ─── ITS demo (sendXrplItsWithGmp.ts) ──────────────────────────────────────────
# XRP drops to transfer as wXRP to XRPL EVM (the token amount)
XRPL_TRANSFER_AMOUNT_DROPS=5000000

# XRP drops reserved for Axelar ITS gas (deducted from total payment)
XRPL_ITS_GAS_FEE_DROPS=2000000

# ─── Submission gate ───────────────────────────────────────────────────────────
# Leave false for a dry-run preview. Set true only when ready to submit live.
XRPL_CONFIRM_SEND=false
