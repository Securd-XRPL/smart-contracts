# XRPL Ledger testnet source wallet
XRPL_RPC_URL=wss://s.altnet.rippletest.net:51233
XRPL_SEED=sYourFundedXrplTestnetSeed

# XRPL Axelar gateway and destination chain
XRPL_AXELAR_GATEWAY=rNrjh1KGZk2jBR3wPfAQnoidtFFYQKbQn2
XRPL_EVM_AXELAR_CHAIN=xrpl-evm

# XRPL EVM adapter and signing context
XRPL_EVM_RPC_URL=https://rpc.testnet.xrplevm.org
XRPL_BRIDGE_ADAPTER=0xYourRedeployedAdapter
INTERCHAIN_TOKEN_SERVICE=0xB5FB4BE02232B1bBA4dC8f81dc24C26980dE9e3C
DEPLOYER_PRIVATE_KEY=0xYourIntentSignerPrivateKey

# Supply target configured in XRPLSecurdBridgeAdapter.setMarket(...)
XRPL_DEPOSIT_DESTINATION_ADDRESS=0xYourRedeployedAdapter
XRPL_DEPOSIT_MARKET=0xYourSErc20Market
XRPL_DEPOSIT_UNDERLYING=0xYourERC20CompatibleUnderlying

# XRP amounts are drops. Payment amount = deposit + gas.
XRPL_DEPOSIT_AMOUNT_DROPS=1000000
XRPL_DEPOSIT_GAS_FEE_DROPS=0

# Optional overrides
XRPL_DEPOSIT_DEADLINE=0
# XRPL_DEPOSIT_NONCE=0
# XRPL_ACCOUNT_BYTES32=0x...
# XRPL_INTENT_ID=0x...

# Keep false for preview. Set true only when ready to submit.
XRPL_CONFIRM_SEND=false
