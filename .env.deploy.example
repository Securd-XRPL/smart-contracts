# XRPL EVM network access
XRPL_EVM_RPC_URL=https://rpc.example.xrplevm.org
XRPL_EVM_CHAIN_ID=1440002
DEPLOYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Final protocol owner / multisig
DEPLOY_OWNER=0x0000000000000000000000000000000000000001
SECURD_PENDING_ADMIN=0x0000000000000000000000000000000000000001

# Axelar contracts already deployed on XRPL EVM
AXELAR_GATEWAY=0x0000000000000000000000000000000000000010
INTERCHAIN_TOKEN_SERVICE=0x0000000000000000000000000000000000000020
XRPL_DESTINATION_CHAIN=xrpl
XRPL_EGRESS_GAS_VALUE=0

# Optional operator addresses
SECURD_PAUSE_GUARDIAN=0x0000000000000000000000000000000000000000
SECURD_BORROW_CAP_GUARDIAN=0x0000000000000000000000000000000000000000

# Oracle / IRM defaults
BAND_STD_REFERENCE=0x0000000000000000000000000000000000000000
SECURD_CLOSE_FACTOR_MANTISSA=500000000000000000
SECURD_LIQUIDATION_INCENTIVE_MANTISSA=1080000000000000000
SECURD_IRM_BASE_RATE_PER_YEAR=0
SECURD_IRM_MULTIPLIER_PER_YEAR=0
SECURD_IRM_JUMP_MULTIPLIER_PER_YEAR=0
SECURD_IRM_KINK=800000000000000000

# Optional deployment inputs
SECURD_MARKETS_FILE=config/securd-markets.example.json
XRPL_TRUSTED_GMP_SOURCES_FILE=config/trusted-gmp-sources.example.json
XRPL_TRUSTED_ITS_SOURCES_FILE=config/trusted-its-sources.example.json
DEPLOYMENT_OUTPUT_FILE=deployments/xrpl-evm-mainnet.example.json

# Optional median reporter deployment inside full-stack deploy
SECURD_DEPLOY_MEDIAN_ORACLE_REPORTER=false
SECURD_MEDIAN_REPORTER_OWNER=0x0000000000000000000000000000000000000001
SECURD_MEDIAN_REPORTER_CONFIG=[{"asset":"0x0000000000000000000000000000000000001000","roundDuration":"300","minSubmissions":2}]
SECURD_MEDIAN_REPORTER_REPORTERS=[{"asset":"0x0000000000000000000000000000000000001000","reporter":"0x0000000000000000000000000000000000002000"}]

# Standalone median reporter deploy script
MEDIAN_REPORTER_OWNER=0x0000000000000000000000000000000000000001
MEDIAN_REPORTER_FALLBACK_ORACLE=0x0000000000000000000000000000000000003000
MEDIAN_REPORTER_ASSET_CONFIGS=[{"asset":"0x0000000000000000000000000000000000001000","roundDuration":"300","minSubmissions":2}]
MEDIAN_REPORTER_REPORTERS=[{"asset":"0x0000000000000000000000000000000000001000","reporter":"0x0000000000000000000000000000000000002000"}]
