{
  "name": "securd-protocol",
  "version": "0.1.0",
  "private": true,
  "description": "Securd lending protocol on XRPL EVM with Axelar integration",
  "scripts": {
    "build": "hardhat compile",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:unit": "hardhat test test/unit/*.ts",
    "test:integration": "hardhat test test/integration/*.ts",
    "test:properties": "hardhat test test/invariant/*.ts",
    "coverage": "hardhat coverage",
    "coverage:check": "ts-node scripts/checkCoverage.ts",
    "clean": "hardhat clean",
    "typecheck": "tsc --noEmit",
    "validate:liquidation-config": "ts-node scripts/validateLiquidationBotConfig.ts config/liquidation-bot.example.json",
    "validate:lp-oracle-config": "ts-node scripts/validateXrplLpOracleConfig.ts config/xrpl-lp-oracle.example.json",
    "bot:lp-oracle": "ts-node scripts/runXrplLpOracleBot.ts config/xrpl-lp-oracle.example.json",
    "test:lp-oracle": "hardhat test test/unit/xrplLpOracleBot.spec.ts test/unit/medianOracleReporter.spec.ts",
    "test:lp-oracle:full": "hardhat test test/unit/xrplLpOracleBot.spec.ts test/unit/medianOracleReporter.spec.ts test/unit/xrplLpOracleQuorum.spec.ts test/integration/medianOracleDeployment.spec.ts",
    "deploy:median-oracle-reporter": "hardhat run scripts/deployMedianOracleReporter.ts --network xrplEvm",
    "aggregate:lp-oracle": "ts-node scripts/runXrplLpOracleAggregator.ts",
    "deploy:keeper": "hardhat run scripts/deployLiquidationKeeper.ts --network xrplEvm",
    "deploy:full-stack": "hardhat run scripts/deploySecurdStack.ts --network xrplEvm",
    "validate:deploy-inputs": "ts-node scripts/validateSecurdDeploymentInputs.ts config/securd-markets.example.json config/trusted-gmp-sources.example.json config/trusted-its-sources.example.json",
    "accept:unitroller-admin": "hardhat run scripts/acceptUnitrollerAdmin.ts --network xrplEvm",
    "validate:deployment-record": "ts-node scripts/validateDeploymentRecord.ts deployments/xrpl-evm-mainnet.example.json",
    "verify:deployment": "hardhat run scripts/verifyDeployedSecurdStack.ts --network xrplEvm",
    "smoke:deployment": "hardhat run scripts/smokeCheckDeployment.ts --network xrplEvm",
    "sign:deployment-manifest": "ts-node scripts/signDeploymentManifest.ts",
    "verify:deployment-manifest": "ts-node scripts/verifyDeploymentManifest.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.8",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.12",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.0",
    "chai": "^4.5.0",
    "ethers": "^6.13.5",
    "hardhat": "^2.22.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@axelar-network/axelar-gmp-sdk-solidity": "^6.0.6",
    "@axelar-network/interchain-token-service": "^2.2.0",
    "@openzeppelin/contracts": "^4.9.6"
  }
}
